# ─────────────────────────────────────────────────────────────────────
# ProjectFlow — Docker Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# .env is in .gitignore and should NEVER be committed.
# ─────────────────────────────────────────────────────────────────────

# MySQL
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=project_management
MYSQL_USER=projectflow
MYSQL_PASSWORD=change_me_db_password

# JWT (must be at least 256 bits / 32 characters)
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars_long
JWT_EXPIRATION=86400000

# CORS — set to your production domain when deploying
# For local Docker: http://localhost
# For production:   https://yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost
